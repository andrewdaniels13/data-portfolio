{
    "LambdaFunctionConfigurations": [
        {
            "Id": "cyclistic-raw-csv-to-lambda",
            "LambdaFunctionArn": "arn:aws:lambda:us-east-1:<ACCOUNT_ID>:function:cyclistic-pipeline-clean-trip-data",
            "Events": [
                "s3:ObjectCreated:*"
            ],
            "Filter": {
                "Key": {
                    "FilterRules": [
                        {
                            "Name": "Prefix",
                            "Value": "cyclistic-raw/"
                        },
                        {
                            "Name": "Suffix",
                            "Value": ".csv"
                        }
                    ]
                }
            }
        }
    ]
}
